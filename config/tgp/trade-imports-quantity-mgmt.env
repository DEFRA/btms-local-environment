ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8085
# The gateway's local STS issues its token to whoever the access key names. This is the principal
# trade-gateway's Development settings give READ and WRITE on /customs/**. Loaded after aws.env.
AWS_ACCESS_KEY_ID=test-customs-quantity-manager
Mongo__DatabaseUri=mongodb://mongodb:27017/?tls=false
USE_FLOCI=true
SQS_ENDPOINT=http://floci:4566

TracesGateway__BaseUrl=http://trade-gateway:8080
DataApi__BaseAddress=http://trade-imports-data-api:8080
DataApi__Password=quantity-mgmt-pwd
ResourceEventsConsumer__ResourceEventsQueueUrl=http://floci:4566/000000000000/trade_imports_data_upserted_quantity_mgmt
