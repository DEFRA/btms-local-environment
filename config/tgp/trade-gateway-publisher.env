ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8085
# The gateway's local STS issues its token to whoever the access key names, as real STS names the
# caller's role. Loaded after aws.env, so this wins for the publisher alone.
AWS_ACCESS_KEY_ID=trade-gateway-publisher
AWS_ENDPOINT_URL=http://floci:4566
Mongo__DatabaseUri=mongodb://mongodb:27017/?tls=false
TracesGateway__BaseUrl=http://trade-gateway:8080
USE_FLOCI=true

# BTMS reads CHEDs from SQS, so the Azure Service Bus fan-out isn't needed here.
FeatureManagement__AzureServiceBusPublishing=false

# Poll every 10 seconds rather than every 2 minutes, so tests don't wait long for a seeded CHED.
Scheduler__Jobs__TracesChedChangesJob__Cron=*/10 * * * * *
